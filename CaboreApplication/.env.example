# ============================================================
# Plantilla de variables de entorno de CABORE (Spring Boot).
# 1) Copia este archivo como ".env" (está en .gitignore, no se sube a git).
# 2) Rellena tus valores reales en ".env".
# NUNCA escribas credenciales secretas reales en este archivo de ejemplo.
# ============================================================

# Nota: el perfil (dev por defecto | prod) se elige con la variable de entorno
# del SISTEMA SPRING_PROFILES_ACTIVE; no funciona desde este archivo.

# Puerto HTTP de la aplicación
SERVER_PORT=8080

# --- MariaDB ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cabore_restaurada
# Usuario de MariaDB (en XAMPP el usuario por defecto es "root")
DB_USERNAME=root
# Tu contraseña real va SOLO en tu archivo .env (en XAMPP por defecto está vacía)
DB_PASSWORD=
# Solo producción (opcional)
# DB_POOL_SIZE=10

# --- Correo SMTP (Recuperación de contraseña) ---
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu_correo@gmail.com
# MAIL_PASSWORD=tu_clave_de_aplicacion
# MAIL_FROM=tu_correo@gmail.com
# APP_BASE_URL=http://localhost:8080

# --- Google Sign-In (Client ID público OAuth 2.0) ---
GOOGLE_CLIENT_ID=853981485167-vsbi9h44ktc32d6c6ppipnls9fc6iqh7.apps.googleusercontent.com

# --- Clave de instalación para /crear-admin (opcional) ---
# ADMIN_SETUP_KEY=define_una_clave_segura_propia
